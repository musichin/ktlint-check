{
  "name": "ktlint-check",
  "version": "4.0.3",
  "description": "GitHub action for ktlint",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format:fix": "biome format --write",
    "format": "biome format",
    "lint:fix": "biome lint --write",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check:ci": "biome ci --reporter=github",
    "test": "vitest run --coverage",
    "build": "node build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musichin/ktlint-check.git"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "Anton Musichin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/musichin/ktlint-check/issues"
  },
  "homepage": "https://github.com/musichin/ktlint-check",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
